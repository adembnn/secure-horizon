# Noms de variables seulement, jamais de valeur. Copier en .env (gitignoré).
# Clé préférée (alignée sur .env.example racine) ; PRIVATE_KEY reste accepté en repli.
FUJI_PRIVATE_KEY=0x...
PRIVATE_KEY=0x...
WALLET_ADDRESS=0x...
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Nœud local (npm run chain:local) : fork = fork local d'Avalanche C-Chain (chainId 43114),
# plain = chaîne vide hors-ligne (chainId 31337). Vide = essaie fork, retombe sur plain.
HOLDUP_CHAIN_MODE=
HOLDUP_FORK_URL=https://api.avax.network/ext/bc/C/rpc
HOLDUP_FORK_BLOCK=
HOLDUP_CHAIN_ID=
HOLDUP_PORT=8545

# Adresse du wallet de la victime (celui utilisé dans l'extension pour la répétition).
DEMO_VICTIM=0x...
