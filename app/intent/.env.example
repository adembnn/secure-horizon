# Sentinelle Intent Barrier - Environment Variables
# Copy this file to .env and fill in your values

# Cloudflare Workers AI (for Clef/Clef-flash models)
# Get these from your Cloudflare dashboard
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Jev API (TypeSafe decision-making AI)
# Get this from TypeSafe
JEV_API_KEY=

# Note: If no API keys are set, the system falls back to keyword-based
# detection which works offline but has lower accuracy.
