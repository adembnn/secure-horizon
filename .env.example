# Variables d'environnement de l'application — NOMS seulement, jamais de valeur.
# Copier en .env (gitignoré) et remplir. Lancer ensuite les scripts avec : node --env-file=.env <script>

# Clef / Clef-flash (Cloudflare Workers AI) : classifieur du message collé.
# dash.cloudflare.com > Workers AI > Use REST API > Create a Workers AI API Token, puis copier l'Account ID sur la même page.
# Jeton personnalisé : il faut « Workers AI : Read » ET « Workers AI : Edit ».
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Classifieur utilisé par le détecteur pasted_message : clef-flash | clef | keyword | off (vide = off).
HOLDUP_CLASSIFIER=
# Seuil de probabilité à partir duquel un signal compte (0 à 1, défaut 0.5 ; à régler avec redteam/measure_classifier.mjs).
HOLDUP_CLEF_THRESHOLD=

# Jev (TypeSafe), même contrat de questions que Clef : https://docs.typesafe.ai/api.md
JEV_API_KEY=

# Wallet de TEST Fuji (jamais un wallet réel) pour déployer les contrats de démo et l'ancrage.
FUJI_PRIVATE_KEY=

# Gradium (voix de synthèse pour la vidéo de démonstration). Clé dans .env seulement, jamais dans le dépôt.
GRADIUM_API_KEY=
