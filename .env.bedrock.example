# Copier en .env.bedrock (gitignoré) et remplir. NE JAMAIS COMMITER .env.bedrock.
# Chargé par scripts/bedrock-env.sh / .ps1 (utilisé par swarm.* et check-bedrock.*). Les lignes vides sont ignorées.
CLAUDE_CODE_USE_BEDROCK=1
# Région fournie par les orgas (ex. us-east-1, eu-west-3). Si eu-*, remplacer le préfixe us. par eu. ou global. ci-dessous.
AWS_REGION=

# --- Credentials : UNE seule des 3 options ---
# Option 1 (préférée) : profil dans ~/.aws  (aws configure --profile hackathon)
AWS_PROFILE=hackathon
# Option 2 : clés directes (laisser vide si option 1)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Option 3 : clé API Bedrock (si définie, Claude Code ignore la chaîne AWS)
AWS_BEARER_TOKEN_BEDROCK=

# --- Modèles (Invoke API, IDs d'inference profile) ---
# IDs de base confirmés côté Bedrock « Mantle » (sans préfixe) : anthropic.claude-opus-5-5,
#   anthropic.claude-sonnet-5-5, anthropic.claude-haiku-5-5, anthropic.claude-fable-5-1.
# Les IDs PRÉFIXÉS ci-dessous (us./eu./global.) sont À VÉRIFIER via :
#   aws bedrock list-inference-profiles --region $AWS_REGION   (ou scripts/check-bedrock.*)
# Opus 5.5 : cité dans la doc Claude Code Bedrock — À VÉRIFIER via aws bedrock list-inference-profiles
ANTHROPIC_DEFAULT_OPUS_MODEL=us.anthropic.claude-opus-5-5
# Sonnet 5.5 : À VÉRIFIER via aws bedrock list-inference-profiles (repli connu : us.anthropic.claude-sonnet-4-6)
ANTHROPIC_DEFAULT_SONNET_MODEL=us.anthropic.claude-sonnet-5-5
# Haiku 4.5 : ID legacy publié (confirmé). Haiku 5.5 préfixé : À VÉRIFIER via aws bedrock list-inference-profiles
ANTHROPIC_DEFAULT_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Modèle principal des workers (Sonnet, moins cher) — À VÉRIFIER (même ID que ANTHROPIC_DEFAULT_SONNET_MODEL)
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-5-5

# --- Options ---
# ANTHROPIC_BEDROCK_REGION_PREFIX=global
# ANTHROPIC_BEDROCK_SERVICE_TIER=priority
# Ne PAS définir DISABLE_PROMPT_CACHING (le cache réduit fortement le coût des workers).
